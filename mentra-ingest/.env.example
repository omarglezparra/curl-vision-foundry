AZURE_CAPTURE_API_BASE=https://your-function-app.azurewebsites.net/api
# Generate an independent random value of at least 32 characters. Placeholder
# values containing "replace", "your", or "example" are rejected.
AZURE_INGEST_API_TOKEN=
STREAM_KEY_SECRET=
# MiniApp counterpart (not consumed by ingest): MENTRA_STREAM_AUTH_TTL_SECONDS=14400
STREAM_AUTH_MAX_TTL_SECONDS=14400
STREAM_AUTH_CLOCK_SKEW_SECONDS=60
RETRY_INTERVAL_SECONDS=60
STALE_CLAIM_SECONDS=300
# Failed/retry/uploading segments are purged after this age. Allowed: 300-604800.
FAILED_SEGMENT_RETENTION_SECONDS=86400
# Keep this above the longest upload (180s) and heartbeat interval (30s).
RETRY_WORKER_HEALTH_MAX_AGE_SECONDS=300

# Required by compose.production.yml. The certificate must cover this DNS name.
RTMPS_DOMAIN=ingest.example.com
RTMPS_CERT_DIR=./certs
