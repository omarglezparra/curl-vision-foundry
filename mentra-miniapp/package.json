{
  "name": "ai-javier-coach-mentra-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mentra Store MiniApp for recording and analyzing curl workouts.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/smoke-test.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@mentra/sdk": "2.1.29",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "patch-package": "8.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "jsonwebtoken": "9.0.3",
    "minimatch": "10.2.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
